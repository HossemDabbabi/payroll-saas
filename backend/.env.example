# ==============================================================================
# PayrollPro Backend Environment Configuration (Template)
# Copy this file to `backend/.env` and supply actual values for your environment.
# NEVER commit the real `.env` file to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (local or remote MongoDB instance)
MONGODB_URI=mongodb://localhost:27017/payroll_saas

# JSON Web Token (JWT) Security
# Replace with a cryptographically secure random string (minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# File Upload Settings
# MAX_FILE_SIZE in bytes (10485760 bytes = 10 MB)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Cross-Origin Resource Sharing (CORS)
FRONTEND_URL=http://localhost:5173

# Payment Gateway (Optional - Stripe integration)
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_testing
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_for_webhooks
